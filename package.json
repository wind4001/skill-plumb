{
  "name": "skill-plumb",
  "version": "0.1.0",
  "description": "Zero-dependency engineering suite for Agent Skills (SKILL.md): thin contracts, 0/1/2 probes, black-box gating, and zero-invasion two-stage routing.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "skill-plumb": "./bin/skill-plumb.mjs"
  },
  "exports": {
    ".": "./src/index.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "templates/",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node tests/run_all.mjs",
    "doctor": "node bin/skill-plumb.mjs doctor"
  },
  "keywords": [
    "agent-skills",
    "skill-md",
    "llm-agents",
    "mcp",
    "routing",
    "cli",
    "zero-dependency"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/wind4001/skill-plumb.git"
  },
  "homepage": "https://github.com/wind4001/skill-plumb#readme",
  "bugs": {
    "url": "https://github.com/wind4001/skill-plumb/issues"
  }
}
